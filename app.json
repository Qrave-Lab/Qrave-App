{
  "expo": {
    "name": "Qrave",
    "slug": "admin-order-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adminorderapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "assassin619007",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qrave.adminorderapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Qrave to access your camera for scanning QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow Qrave to access your photo library to upload images."
      }
    },
    "android": {
      "package": "com.qrave.adminorderapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a5775709-17bc-4131-bcb7-9fbfbf1991c9"
      },
      "router": {}
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
